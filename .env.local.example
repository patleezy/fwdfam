# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # Safe for client
SUPABASE_SERVICE_ROLE_KEY=          # NEVER expose to client

# Google OAuth (Google Calendar users)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple CalDAV (Apple Calendar users)
# No server-side keys needed -- credentials are per-user, stored in oauth_tokens table.
# Apple requires users to generate an app-specific password at appleid.apple.com.
CALDAV_BASE_URL=https://caldav.icloud.com

# LLM
LLM_PROVIDER=gemini-flash-lite      # 'gemini-flash-lite' | 'gemini-flash' | 'claude'
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Postmark
POSTMARK_WEBHOOK_TOKEN=             # validate all inbound webhooks
POSTMARK_SERVER_TOKEN=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=                    # $5/month recurring price ID from Stripe dashboard

# App
NEXT_PUBLIC_APP_URL=https://fwdfam.app
INBOUND_EMAIL_DOMAIN=mail.fwdfam.app
